diff -ruN a/tools/gen_frames.py b/tools/gen_frames.py
--- a/tools/gen_frames.py
+++ b/tools/gen_frames.py
@@ -0,0 +1,25 @@
+# rasmlar/<mashq>_1.(png|jpg|webp) va <mashq>_2.* fayllarini ilovaga tayyorlaydi:
+# 512px gacha kichraytiradi, WebP qiladi va img/frames.js ro'yxatini yozadi.
+import io, json, os, re, sys
+
+SRC = sys.argv[1] if len(sys.argv) > 1 else 'rasmlar'
+WWW = os.path.join(os.path.dirname(__file__), '..', 'app', 'src', 'main', 'assets', 'www')
+OUT = os.path.join(WWW, 'img')
+os.makedirs(OUT, exist_ok=True)
+frames = {}
+if os.path.isdir(SRC):
+    from PIL import Image
+    for name in sorted(os.listdir(SRC)):
+        m = re.match(r'^([a-z]+)_([12])\.(png|jpe?g|webp)$', name, re.I)
+        if not m:
+            print('O\'tkazib yuborildi (nomi mos emas):', name); continue
+        key, n = m.group(1).lower(), int(m.group(2))
+        im = Image.open(os.path.join(SRC, name)).convert('RGB')
+        im.thumbnail((512, 512))
+        dst = '%s_%d.webp' % (key, n)
+        im.save(os.path.join(OUT, dst), 'WEBP', quality=80)
+        frames.setdefault(key, [None, None])[n - 1] = 'img/' + dst
+frames = {k: v for k, v in frames.items() if all(v)}
+with io.open(os.path.join(OUT, 'frames.js'), 'w', encoding='utf-8') as f:
+    f.write('// Avtomatik yasalgan: mashq rasmlari\nwindow.SIHAT_FRAMES = %s;\n' % json.dumps(frames, ensure_ascii=False))
+print('Rasmli mashqlar:', ', '.join(sorted(frames)) or 'yo\'q')
