diff -ruN a/app/src/main/java/uz/sihat/app/StepJob.java b/app/src/main/java/uz/sihat/app/StepJob.java
--- a/app/src/main/java/uz/sihat/app/StepJob.java
+++ b/app/src/main/java/uz/sihat/app/StepJob.java
@@ -0,0 +1,78 @@
+package uz.sihat.app;
+
+import android.app.job.JobInfo;
+import android.app.job.JobParameters;
+import android.app.job.JobScheduler;
+import android.app.job.JobService;
+import android.content.ComponentName;
+import android.content.Context;
+import android.hardware.Sensor;
+import android.hardware.SensorEvent;
+import android.hardware.SensorEventListener;
+import android.hardware.SensorManager;
+import android.os.Handler;
+import android.os.Looper;
+
+/**
+ * Fon vazifasi: taxminan har 15 daqiqada qadam sensorini bir marta o'qib saqlaydi.
+ * Shunda ilova bir necha kun ochilmasa ham qadamlar to'g'ri kunga yoziladi,
+ * telefon o'chib-yonsa ham ko'pi bilan oxirgi 15 daqiqalik qadamlar yo'qoladi.
+ */
+public class StepJob extends JobService implements SensorEventListener {
+    private static final int JOB_ID = 7001;
+
+    private SensorManager sm;
+    private JobParameters params;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private final Runnable timeout = () -> done();
+
+    static void schedule(Context c) {
+        JobScheduler js = (JobScheduler) c.getSystemService(Context.JOB_SCHEDULER_SERVICE);
+        if (js == null) return;
+        for (JobInfo j : js.getAllPendingJobs()) if (j.getId() == JOB_ID) return; // allaqachon rejalashtirilgan
+        JobInfo info = new JobInfo.Builder(JOB_ID, new ComponentName(c, StepJob.class))
+                .setPeriodic(15 * 60 * 1000L)
+                .setPersisted(true)
+                .build();
+        try { js.schedule(info); } catch (Exception ignored) { }
+    }
+
+    @Override
+    public boolean onStartJob(JobParameters p) {
+        params = p;
+        sm = (SensorManager) getSystemService(Context.SENSOR_SERVICE);
+        Sensor s = sm == null ? null : sm.getDefaultSensor(Sensor.TYPE_STEP_COUNTER);
+        if (s == null) return false;
+        try {
+            sm.registerListener(this, s, SensorManager.SENSOR_DELAY_NORMAL);
+        } catch (Exception e) {
+            return false;
+        }
+        handler.postDelayed(timeout, 20000);
+        return true;
+    }
+
+    @Override
+    public void onSensorChanged(SensorEvent e) {
+        if (e.sensor.getType() != Sensor.TYPE_STEP_COUNTER) return;
+        StepStore.record(this, (long) e.values[0]);
+        done();
+    }
+
+    @Override
+    public void onAccuracyChanged(Sensor sensor, int accuracy) { }
+
+    private void done() {
+        handler.removeCallbacks(timeout);
+        if (sm != null) sm.unregisterListener(this);
+        if (params != null) { jobFinished(params, false); params = null; }
+    }
+
+    @Override
+    public boolean onStopJob(JobParameters p) {
+        handler.removeCallbacks(timeout);
+        if (sm != null) sm.unregisterListener(this);
+        params = null;
+        return true;
+    }
+}
diff -ruN a/app/src/main/java/uz/sihat/app/StepStore.java b/app/src/main/java/uz/sihat/app/StepStore.java
--- a/app/src/main/java/uz/sihat/app/StepStore.java
+++ b/app/src/main/java/uz/sihat/app/StepStore.java
@@ -0,0 +1,41 @@
+package uz.sihat.app;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Locale;
+
+/**
+ * Qadamlarni saqlash mantig'i — ilova ham, fon vazifasi (StepJob) ham shuni ishlatadi.
+ * TYPE_STEP_COUNTER telefon yoqilgandan beri jami qadamni beradi; oxirgi ko'rilgan
+ * qiymat bilan farq o'sha paytdagi kunga qo'shiladi.
+ */
+final class StepStore {
+    private StepStore() { }
+
+    static String day(Date d) {
+        return new SimpleDateFormat("yyyy-MM-dd", Locale.US).format(d);
+    }
+
+    static SharedPreferences prefs(Context c) {
+        return c.getSharedPreferences("steps", Context.MODE_PRIVATE);
+    }
+
+    static synchronized void record(Context c, long total) {
+        SharedPreferences p = prefs(c);
+        String today = day(new Date());
+        long last = p.getLong("last_total", -1);
+        long todaySteps = p.getLong("steps_" + today, 0);
+        if (last >= 0) {
+            long delta = total - last;
+            if (delta < 0) delta = total; // telefon qayta yoqilgan: hisob noldan boshlangan
+            if (delta > 0 && delta < 100000) todaySteps += delta;
+        }
+        p.edit()
+                .putLong("steps_" + today, todaySteps)
+                .putLong("last_total", total)
+                .apply();
+    }
+}
diff -ruN a/tools/gen_voice.py b/tools/gen_voice.py
--- a/tools/gen_voice.py
+++ b/tools/gen_voice.py
@@ -0,0 +1,40 @@
+# Ovozli murabbiy uchun o'zbekcha mp3 fayllarni yasaydi (APK yig'ishda GitHub'da ishlaydi).
+# Iboralar app/src/main/assets/www/data.js ichidagi /*VOICE*/ ... /*/VOICE*/ blokidan olinadi.
+import asyncio, io, json, os, re, sys
+
+WWW = os.path.join(os.path.dirname(__file__), '..', 'app', 'src', 'main', 'assets', 'www')
+VOICE_NAME = os.environ.get('SIHAT_VOICE', 'uz-UZ-SardorNeural')
+
+def phrases():
+    src = io.open(os.path.join(WWW, 'data.js'), encoding='utf-8').read()
+    block = src.split('/*VOICE*/')[1].split('/*/VOICE*/')[0]
+    obj = block[block.index('{'):block.rindex('}') + 1]
+    return json.loads(obj)
+
+async def main():
+    import edge_tts
+    out = os.path.join(WWW, 'voice')
+    os.makedirs(out, exist_ok=True)
+    ok = 0
+    for key, text in phrases().items():
+        path = os.path.join(out, key + '.mp3')
+        if os.path.exists(path):
+            ok += 1; continue
+        for attempt in range(3):
+            try:
+                await edge_tts.Communicate(text, VOICE_NAME, rate='-5%').save(path)
+                ok += 1
+                print('OK ', key, '-', text)
+                break
+            except Exception as e:
+                print('qayta urinish', key, e)
+                await asyncio.sleep(2)
+    print('Tayyor: %d ta fayl' % ok)
+
+if __name__ == '__main__':
+    try:
+        asyncio.run(main())
+    except Exception as e:
+        # Ovoz yasalmasa ham APK yig'ilaversin (ilova TTS yoki signalga o'tadi)
+        print('Ovoz yasab bo\'lmadi:', e)
+        sys.exit(0)
